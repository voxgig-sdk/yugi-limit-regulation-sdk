      req: false
      short: "List of card IDs that are semi-limited (only 2 copies allowed)"
      type: "`$ARRAY`"
    }
    {
      name: "unlimited"
      req: false
      short: "List of card IDs that have been moved to unlimited (3 copies allowed)"
      type: "`$ARRAY`"
    }
  ]

